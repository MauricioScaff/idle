# Normaliza fins de linha (LF no repositório)
* text=auto

# Arquivos da Unity em YAML
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf

# Binários
*.png  binary
*.jpg  binary
*.psd  binary
*.aseprite binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
